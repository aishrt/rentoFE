# Copy to frontend/.env.local for local development.
# Only public values go here: everything prefixed VITE_ is built into the browser bundle (IMPLEMENTATION_PLAN.md §2.5).

# The backend API origin (no trailing slash). Locally the backend runs on port 4000.
VITE_API_URL=http://localhost:4000

# Stripe publishable key (Stripe Dashboard → Developers → API keys). pk_test_… for the sandbox. It is
# public by design; the secret key (sk_…) goes only in backend/.env.
VITE_STRIPE_PUBLISHABLE_KEY=
